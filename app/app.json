{
  "expo": {
    "name": "Lipidly",
    "slug": "lipidly",
    "scheme": "lipidly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/app-icon-ios-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sidathasiri.lipidly",
      "infoPlist": {
        "NSCameraUsageDescription": "Lipidly uses the camera to photograph your lab reports and prescriptions.",
        "NSPhotoLibraryUsageDescription": "Lipidly lets you choose a photo of a lab report or prescription."
      },
      "icon": "./assets/brand/png/app-icon-ios-1024.png"
    },
    "android": {
      "package": "com.lipidly.app",
      "adaptiveIcon": {
        "backgroundColor": "#ECFEFF",
        "foregroundImage": "./assets/brand/png/android-adaptive-foreground-432.png",
        "backgroundImage": "./assets/brand/png/android-adaptive-background-432.png",
        "monochromeImage": "./assets/brand/png/android-adaptive-monochrome-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/png/logo-mark-1024.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7490",
          "image": "./assets/brand/png/logo-mark-white-1024.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lipidly uses the camera to photograph your lab reports and prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lipidly lets you choose a photo of a lab report or prescription."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/png/android-notification-96.png",
          "color": "#0E7490"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
