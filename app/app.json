{
  "expo": {
    "name": "Lipidly",
    "slug": "lipidly",
    "scheme": "lipidly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lipidly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Lipidly uses the camera to photograph your lab reports and prescriptions.",
        "NSPhotoLibraryUsageDescription": "Lipidly lets you choose a photo of a lab report or prescription."
      }
    },
    "android": {
      "package": "com.lipidly.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E7490",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7490",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lipidly uses the camera to photograph your lab reports and prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lipidly lets you choose a photo of a lab report or prescription."
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
